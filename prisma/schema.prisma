datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Notebook {
  id        String   @id
  name      String
  color     String
  sortOrder Int      @default(0)
  isArchived Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  notes     Note[]

  @@index([sortOrder], map: "NotesNotebook_sortOrder_idx")
  @@map("NotesNotebook")
}

model Note {
  id         String   @id
  notebook   Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  notebookId String
  title      String
  content    String   @default("")
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([notebookId, sortOrder], map: "NotesEntry_notebookId_sortOrder_idx")
  @@map("NotesEntry")
}
