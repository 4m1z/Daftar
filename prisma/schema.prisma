datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model NotesNotebook {
  id        String   @id
  name      String
  color     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  notes     NotesEntry[]

  @@index([sortOrder])
}

model NotesEntry {
  id         String        @id
  notebook   NotesNotebook @relation(fields: [notebookId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  notebookId String
  title      String
  content    String        @default("")
  sortOrder  Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([notebookId, sortOrder])
}
